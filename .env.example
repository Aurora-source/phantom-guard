# Copy to .env for Compose substitutions; CLI does not automatically load .env.
PHANTOMGUARD_PORT=8765
PHANTOMGUARD_WORKERS=2
PHANTOMGUARD_MAX_CYCLES=1200
PHANTOMGUARD_JOB_SECONDS=120
# After restoring the completed deployment bundle, show the fresh portable run.
# This is a path inside the container, not a Windows host path.
PHANTOMGUARD_REPORTS_DIR=/workspace/docs/results/portable
# Host mounts may be absolute Linux paths; defaults are relative to compose.yaml.
PHANTOMGUARD_DATA_MOUNT=./data/raw
PHANTOMGUARD_MODELS_MOUNT=./models

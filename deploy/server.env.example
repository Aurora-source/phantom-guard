# Copy to .env.server; scripts/server-compose always selects both Compose files.
PHANTOMGUARD_IMAGE=phantomguard-server:local
PHANTOMGUARD_PORT=8765
PHANTOMGUARD_CPU_PERIOD=10000
PHANTOMGUARD_CPU_QUOTA=2500
PHANTOMGUARD_MEMORY=2g
PHANTOMGUARD_MEMORY_SWAP=2g
PHANTOMGUARD_WORKERS=1
PHANTOMGUARD_MAX_CYCLES=1200
PHANTOMGUARD_JOB_SECONDS=150
PHANTOMGUARD_MAX_QUEUED=2
PHANTOMGUARD_MAX_JOBS=6
PHANTOMGUARD_MAX_SESSIONS=16
PHANTOMGUARD_TTL=600
PHANTOMGUARD_OUTPUT_MIB=64
PHANTOMGUARD_JOB_COOLDOWN=30
PHANTOMGUARD_REPORTS_DIR=/workspace/docs/results/portable
PHANTOMGUARD_DATA_MOUNT=./data/raw
PHANTOMGUARD_MODELS_MOUNT=./models
